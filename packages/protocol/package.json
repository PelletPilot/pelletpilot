{
  "name": "@pelletpilot/protocol",
  "version": "0.1.0",
  "description": "TypeScript codec for the pellet-grill FE..FF serial protocol + local RPC client.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test --experimental-strip-types test/*.ts",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "keywords": ["pellet-grill", "pit-boss", "smoker", "bbq", "protocol", "mongoose-os"],
  "publishConfig": { "access": "public" },
  "devDependencies": { "typescript": "^5.6.0" }
}

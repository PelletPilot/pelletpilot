# Copy to .env and fill in. .env is gitignored.

# --- Local grill (for tools/ and local-only app mode) ---
PELLETPILOT_GRILL_IP=192.168.4.1        # your grill's LAN IP (find it in DHCP leases)

# --- Server (packages/server) ---
PORT=8080
DATABASE_URL=file:./pelletpilot.db      # SQLite for easy self-host; swap for Postgres URL
JWT_SECRET=change-me                     # sign user/device tokens
PUBLIC_WS_HOST=pilot.example.com         # host the firmware connects back to

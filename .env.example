# Copy to .env and adjust. .env is gitignored.

# --- Local grill (tools/ and local-only app mode) ---
PELLETPILOT_GRILL_IP=192.168.4.1        # your grill's LAN IP (find it in DHCP leases)

# --- Self-host server (packages/server) — OSS build, no auth ---
PORT=8080
HOST=0.0.0.0
DB_FILE=./data/pelletpilot.db           # SQLite; persists devices + cook history
POLL_INTERVAL_MS=10000                   # how often to sample each device
